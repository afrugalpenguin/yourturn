{
  "name": "yourturn",
  "version": "0.1.0",
  "description": "Scans the Teams channels you are a member of and posts a digest of the messages that need your action.",
  "license": "MIT",
  "author": "afrugalpenguin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afrugalpenguin/yourturn.git"
  },
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "func start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "preview": "tsx scripts/preview.ts",
    "demo": "tsx scripts/demo.ts",
    "dry-run": "tsx scripts/dryRun.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.4"
  }
}
